{{#if errors}}
  {{#each errors}}
    <p class="alert">{{this}}</p>
  {{/each}}
{{/if}}

<form action="{{action}}" method="post" id="manga">
  <fieldset>
    <legend>{{pageTitle}}</legend>

    <div>
      <label for="title"> Título:</label>
      <input
        type="text"
        id="title"
        name="title"
        required
        value="{{manga.title}}"
      />
    </div>

    <div>
      <label for="number"> Volume:</label>
      <input
        type="number"
        id="number"
        name="number"
        min="1"
        step="1"
        required
        value="{{manga.number}}"
      />
    </div>

    <div>
      <label for="price"> Preço:</label>
      <input
        type="number"
        id="price"
        name="price"
        min="0.01"
        step="0.01"
        required
        value="{{manga.price}}"
      />
    </div>

    <div>
      <label for="summary"> Sinopse:</label>
      <textarea id="summary" name="summary" rows="4">{{manga.summary}}</textarea>
    </div>
    <input type="submit" />
  </fieldset>
</form>

<a href="/mangas">Voltar</a>
