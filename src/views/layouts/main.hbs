<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{pageTitle}}</title>
    <style>
      body {
        max-width: 80%;
        min-width: 70%;
        margin: 10% auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }
      
      table {
        --color: #d0d0f5;
        text-align: left;
        border-collapse: collapse;
        caption-side: bottom;
        width: 100%;
      }


      thead,
      tfoot {
        background: var(--color);
      }

      thead {
        border-block-end: 2px solid;
      }

      caption {
        text-align: start;
      }

      thead,
      td {
        text-align: end;
      }

      th,
      td {
        padding: 0.25rem 0.75rem;
      }

      tbody tr:nth-child(even) {
        background: color-mix(in srgb, var(--color), transparent 60%);
      }

      /* .button: um link (<a>) com aparência de botão.
         Links levam a outra página (GET); botões enviam ações (POST). */
      button,
      .button {
        background-color: var(--color);
        border: 1px solid gray;
        border-radius: 4px;
        cursor: pointer;
      }

      .button {
        display: inline-block;
        padding: 1px 6px;
        font-size: 13.33px;
        color: inherit;
        text-decoration: none;
      }
      fieldset {
        display: flex;
        flex-direction: column;
        gap: 5px;
        border: 1px solid gray;
        border-radius: 10px;
      }

      fieldset > div {
        display: flex;
        justify-content: space-between;
      }

      label {
        margin-right: 10px;
      }

      input[type=submit] {
        margin: 10px 0;
      }

      .alert {
        background-color: rgb(255, 86, 86);
        border-radius: 10px;
        padding: 10px;
        margin-top: 5px;
        color: white;
      }

      
    </style>
  </head>
  <body>
    <main>
      {{{body}}}
    </main>
  </body>
</html>